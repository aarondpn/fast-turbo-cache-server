# Loaded by docker-compose.yml for STORAGE_TYPE=rustfs, BEFORE `.env` (so `.env` can override it).
# The server's built-in default endpoint (http://127.0.0.1:9000) would point at the turbo-cache
# container itself; inside compose the bundled store is reachable by its service name.
S3_ENDPOINT=http://rustfs:9000
