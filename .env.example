# fast-turbo-cache-server example environment. Copy to `.env` (git-ignored) and adjust:
#   cp .env.example .env
# docker-compose.yml reads this file for interpolation AND passes every variable to the server
# (env_file). HOST, PORT, LOCAL_STORAGE_PATH and SPOOL_DIR are fixed by docker-compose.yml for
# the container. The full option list with descriptions is in docs/configuration.md.
# Commented-out values are the built-in defaults (exception: S3_BUCKET, see below) or examples;
# every line is valid when uncommented as written. Comment a line out instead of leaving it
# empty: an empty value is a startup error for numbers, booleans, choices, file paths and HOST
# (e.g. `PORT=`, `S3_FORCE_PATH_STYLE=`), and means "unset" for other text values. Inline
# `# ...` comments are not supported; comments go on their own line.

# --- Authentication (required: at least one token, or ALLOW_UNAUTHENTICATED=true) ---------
# Use long random tokens, e.g. `openssl rand -hex 32`.
# The server refuses to start until a token (or ALLOW_UNAUTHENTICATED=true) is set.
# TURBO_TOKEN=
# TURBO_TOKEN_FILE=/run/secrets/turbo_token
# TURBO_SCOPED_TOKENS=team-a=token-a,team-b=token-b
# TURBO_SCOPED_TOKENS_FILE=/run/secrets/turbo_scoped_tokens
# Read-only tokens (no uploads or deletes), e.g. for developer machines.
# TURBO_READ_ONLY_TOKENS=read-only-token
# TURBO_READ_ONLY_TOKEN_FILE=/run/secrets/turbo_read_only_tokens
# TURBO_SCOPED_READ_ONLY_TOKENS=team-a=read-only-token-a
# TURBO_SCOPED_READ_ONLY_TOKENS_FILE=/run/secrets/turbo_scoped_read_only_tokens
# OIDC token exchange for CI, e.g. GitHub Actions (docs/authentication.md). OIDC_ISSUER
# enables it and then requires OIDC_AUDIENCE, OIDC_REQUIRED_CLAIMS and a signing key.
# OIDC_ISSUER=https://token.actions.githubusercontent.com
# OIDC_AUDIENCE=https://turbo-cache.example.com
# (required: issuer and audience alone admit every GitHub workflow; same claim = any of)
# OIDC_REQUIRED_CLAIMS=repository_owner_id=123456
# (others get read-only cache tokens; unset = all read-write. Name the repository and the push
# event: ref alone also matches other repositories and pull_request_target runs)
# OIDC_WRITE_CLAIMS=repository_id=654321,ref=refs/heads/main,event_name=push
# (cache tokens only valid for the namespace in this claim; TURBO_TEAM must match, here
# ${{ github.repository_owner_id }})
# OIDC_NAMESPACE_CLAIM=repository_owner_id
# OIDC_TOKEN_TTL_SECS=3600
# (base64 of at least 32 bytes: `openssl rand -base64 32`; the same on every replica, one key
# per deployment)
# OIDC_SIGNING_KEY=
# OIDC_SIGNING_KEY_FILE=/run/secrets/oidc_signing_key
# ALLOW_UNAUTHENTICATED=false

# --- Docker Compose only (not read by the server) -------------------------------------------
# Host address/port the container is published on. Keep 127.0.0.1 unless a TLS-terminating
# reverse proxy on another host needs to reach it.
# BIND_ADDRESS=127.0.0.1
# PORT=3000
# TURBO_CACHE_IMAGE=fast-turbo-cache-server:local
# TURBO_CACHE_MEM_LIMIT=1g
# RUSTFS_MEM_LIMIT=1g
# GARAGE_MEM_LIMIT=1g
# COMPOSE_PROFILES=rustfs

# --- Storage backend --------------------------------------------------------------------------
# (local | s3 | rustfs | garage | gcs | azure)
# STORAGE_TYPE=local

# Retention, for every backend (see "Retention" in docs/storage.md). Object stores: age = time
# since the upload, every run lists the prefix twice, and STORAGE_PREFIX is required.
# (0 = unlimited)
# STORAGE_MAX_BYTES=0
# (0 = never expire)
# STORAGE_MAX_AGE_SECS=0
# (also the interval of the orphaned spool file sweep)
# STORAGE_CLEANUP_INTERVAL_SECS=600

# Object stores (s3, rustfs, garage, gcs, azure; ignored by local)
# (key prefix inside the bucket or container)
# STORAGE_PREFIX=
# STORAGE_MAX_RETRIES=3
# (memory per streamed upload: (STORAGE_PARTS_IN_FLIGHT + 1) x 8 MiB)
# STORAGE_PARTS_IN_FLIGHT=4
# STORAGE_CONNECT_TIMEOUT_SECS=5
# STORAGE_READ_TIMEOUT_SECS=30

# Bundled stores: set STORAGE_TYPE and start the matching profile. docker-compose.yml then
# sets S3_ENDPOINT to the bundled store (compose/<STORAGE_TYPE>.env); set S3_ENDPOINT below
# only for an external store (it overrides that default).
# Bundled RustFS (`docker compose --profile rustfs up -d`):
# STORAGE_TYPE=rustfs
# Bundled Garage (`docker compose --profile garage up -d`), which also needs the two GARAGE_*
# settings below:
# STORAGE_TYPE=garage
# (default: http://rustfs:9000 / http://garage:3900 for the bundled stores under compose;
# otherwise AWS_ENDPOINT_URL, else the server's built-in default). Keep this line commented out
# for the bundled stores: an empty value also overrides the compose default and makes the server
# fall back to its built-in loopback default (it logs a warning).
# S3_ENDPOINT=https://s3.example.com
# Also forwarded from the shell by docker-compose.yml.
# For the bundled stores these credentials are also the store's credentials (secret: at least
# 8 characters; for Garage the key ID needs 8-128 characters [A-Za-z0-9._-] and the secret must
# not contain quotes, backslashes or whitespace).
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Garage profile only (not read by the server): cluster RPC secret (64 hex characters) and admin
# API token (at least 16 characters), e.g. `openssl rand -hex 32` for both.
# GARAGE_RPC_SECRET=
# GARAGE_ADMIN_TOKEN=
# Bucket name. Required by the server for every S3 backend (it has no built-in default).
# docker-compose.yml passes `turbo-cache` when it is unset; this is also the bucket the bundled
# rustfs/garage profiles create. Set it explicitly for an external store.
# S3_BUCKET=turbo-cache
# (default: AWS_REGION/AWS_DEFAULT_REGION, else garage|us-east-1)
# S3_REGION=
# S3_SECRET_ACCESS_KEY_FILE=/run/secrets/s3_secret_access_key
# S3_SESSION_TOKEN=
# (default: true for rustfs/garage, a custom endpoint or a bucket name containing '.',
# false otherwise; set true/false only to override, an empty value is a startup error)
# S3_FORCE_PATH_STYLE=true
# S3_SIGN_PAYLOAD=false
# S3_TREAT_403_AS_MISS=false
# (probed by /readyz instead of a LIST of STORAGE_PREFIX, for policies without s3:ListBucket)
# S3_HEALTH_CHECK_KEY=

# Google Cloud Storage (STORAGE_TYPE=gcs)
# GCS_BUCKET=turbo-cache
# (default: Application Default Credentials: GOOGLE_APPLICATION_CREDENTIALS, gcloud login,
# metadata server / GKE Workload Identity)
# GCS_SERVICE_ACCOUNT_KEY_FILE=/run/secrets/gcs-key.json

# Azure Blob Storage (STORAGE_TYPE=azure). Without an access key or SAS token, workload identity
# (AZURE_CLIENT_ID, AZURE_TENANT_ID, AZURE_FEDERATED_TOKEN_FILE) or managed identity is used.
# AZURE_STORAGE_ACCOUNT=myaccount
# AZURE_CONTAINER=turbo-cache
# AZURE_STORAGE_ACCESS_KEY=
# AZURE_STORAGE_ACCESS_KEY_FILE=/run/secrets/azure_storage_access_key
# AZURE_STORAGE_SAS_TOKEN=
# (default: https://<account>.blob.core.windows.net; Azurite: http://127.0.0.1:10000/devstoreaccount1)
# AZURE_STORAGE_ENDPOINT=https://myaccount.blob.core.chinacloudapi.cn

# Local filesystem backend
# LOCAL_TEMP_MAX_AGE_SECS=3600

# --- Limits & caching -----------------------------------------------------------------------
# (S3: at most 5 GiB with IMMUTABLE_ARTIFACTS=true, otherwise 10000 x 8 MiB multipart parts)
# MAX_ARTIFACT_SIZE=536870912
# MAX_CONCURRENT_UPLOADS=32
# (0 = automatic: half of MAX_CONCURRENT_UPLOADS with TURBO_SCOPED_TOKENS or OIDC_NAMESPACE_CLAIM, otherwise unlimited)
# MAX_CONCURRENT_UPLOADS_PER_NAMESPACE=0
# BATCH_HEAD_CONCURRENCY=64
# UPLOAD_SLOT_WAIT_SECS=10
# (larger uploads are spooled to SPOOL_DIR, or streamed to S3 in 8 MiB multipart parts)
# UPLOAD_MEMORY_THRESHOLD=4194304
# MEMORY_CACHE_MAX_BYTES=134217728
# MEMORY_CACHE_MAX_ENTRIES=10000
# HOT_CACHE_MAX_ITEM_BYTES=4194304
# METADATA_CACHE_MAX_ENTRIES=50000
# CACHE_TTL_SECS=300
# NEGATIVE_CACHE_TTL_SECS=0

# --- Behaviour ------------------------------------------------------------------------------
# (enabled | disabled | over_limit | paused)
# CACHING_STATUS=enabled
# ISOLATE_TEAMS=true
# (requires ALLOW_DELETE=false)
# IMMUTABLE_ARTIFACTS=false
# ALLOW_DELETE=false
# PROTECT_OBSERVABILITY=false
# CORS_ALLOW_ORIGIN=*

# --- HTTP server ----------------------------------------------------------------------------
# BODY_IDLE_TIMEOUT_SECS=30
# BODY_TOTAL_TIMEOUT_SECS=900
# SHUTDOWN_GRACE_SECS=30

# --- Logging --------------------------------------------------------------------------------
# (text | json)
# LOG_FORMAT=text
# One access log line per request at INFO; `info,fast_turbo_cache_server::access=off` disables them.
# RUST_LOG=info
